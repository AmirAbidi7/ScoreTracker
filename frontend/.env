# Base URL of the PlayBoard backend. socket.io shares this origin.
#
# Web (expo start --web):  localhost is correct.
# Physical device via Expo Go: localhost points at the DEVICE, not your
# machine. Put your LAN address here instead, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
# Find it with `ip addr` / `ipconfig getifaddr en0`.
#
# This file is committed. Put machine-specific values in .env.local instead,
# which is gitignored.
EXPO_PUBLIC_API_URL=http://localhost:3000
